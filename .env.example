# .env.example
#
# Every environment variable clickkart-auth-service reads, across its bootstrap
# application.properties and all 4 config-repo profiles (dev/test/qa/prod). Copy to `.env`
# for local Docker Compose use:
#   cp .env.example .env
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up --build
#
# dev has safe fallbacks for everything below (see clickkart-auth-service-dev.properties) - this
# file only needs to be populated for test/qa/prod, where the config-repo profiles deliberately
# have NO fallback and fail fast at startup if a value is missing.

# --- Runtime ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# --- Config Server (bootstrap - resolved before any profile-specific property) ---
CONFIG_SERVER_HOST=localhost
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_USERNAME=admin
CONFIG_SERVER_PASSWORD=dev-only-secret-change-me

# --- Eureka ---
EUREKA_SERVER_HOST=localhost
EUREKA_SERVER_PORT=8761
EUREKA_DASHBOARD_USERNAME=admin
EUREKA_DASHBOARD_PASSWORD=dev-only-secret-change-me
AUTH_SERVICE_HOSTNAME=localhost

# --- Database (managed Postgres endpoint in qa/prod - never a container, see docs/architecture) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clickkart_auth
# This service's OWN least-privilege role - never the postgres superuser. The role owns only
# clickkart_auth and has CONNECT revoked on the other services' databases, so this credential
# cannot reach their data even if it leaks. See clickkart-config-repository's README for the
# provisioning SQL. There is no default password on any profile (dev included): supply the real
# generated one here.
DB_USERNAME=clickkart_auth_app
DB_PASSWORD=

# --- Redis (revoked-jti store - MUST match the Gateway's own REDIS_HOST/PORT) ---
REVOCATION_REDIS_HOST=localhost
REVOCATION_REDIS_PORT=6379

# --- JWT / auth tuning (see AuthProperties - defaults shown match dev) ---
# MUST be identical to the Gateway's own JWT_SECRET, or token validation breaks cross-service.
JWT_SECRET=dev-only-secret-change-me-please-32bytes-minimum
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_ENCODER_STRENGTH=12
REFRESH_TOKEN_BYTES=64
# MUST match the Gateway's own revoked-jti key prefix exactly.
REVOCATION_KEY_PREFIX=revoked:jti:
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
PASSWORD_RESET_TOKEN_BYTES=32
PASSWORD_HISTORY_LIMIT=5
# Comma-separated. Defense in depth only - the Gateway has its own CORS config too, but this
# service is independently reachable. Set to the real frontend origin(s) in qa/prod.
ALLOWED_ORIGINS=http://localhost:4200
# Per-IP-per-path fixed-window rate limit (Redis-backed) on register/login/refresh/forgot-password/
# reset-password - max requests allowed within the window below before a 429.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Login OTP - digit length, validity window, and wrong-guess tolerance before a single issued
# code burns itself out (independent of the account-level lockout above).
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
# Email/mobile verification codes - a separate, more generous TTL than login OTP above, since
# confirming a contact detail isn't time-pressured the way logging in is.
VERIFICATION_CODE_TTL_SECONDS=86400
VERIFICATION_CODE_MAX_VERIFY_ATTEMPTS=5
# Comma-separated CIDRs/IPs of proxies allowed to set X-Forwarded-For (e.g. the Gateway's own
# address) - empty means "trust nothing but the immediate socket address" (safe default even in
# prod). Set to the real Gateway/ingress CIDR once one exists in front of this service.
AUTH_TRUSTED_PROXY_CIDRS=

# --- This service's own actuator/admin Basic Auth (unrelated to end-user login) ---
AUTH_SERVICE_ADMIN_USERNAME=admin
AUTH_SERVICE_ADMIN_PASSWORD=dev-only-secret-change-me

# --- Logging ---
LOG_PATH=./logs
